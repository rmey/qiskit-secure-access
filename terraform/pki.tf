####################################
# EasyRSA PKI — local-exec provisioner
#
# Prerequisites on the Terraform operator machine:
#   - git
#   - bash
#   - openssl (used by easyrsa internally)
#
# The provisioner clones easyrsa once into ./pki-work/, builds the PKI,
# and writes output cert/key files into ./pki-output/.
# The trigger is based on a sentinel file so it only re-runs if the
# output directory is missing (idempotent across plan/apply cycles).
####################################

locals {
  pki_root_dir   = abspath(path.module)
  pki_work_dir   = "${abspath(path.module)}/pki-work/easyrsa3"
  pki_output_dir = "${abspath(path.module)}/pki-output"

  server_cn = "vpn-server.vpn.ibm.com"
  client_cn = "client1.vpn.ibm.com"
}

resource "null_resource" "easyrsa_pki" {
  # Re-run only when the sentinel file is absent (first apply or after destroy).
  triggers = {
    sentinel = "${local.pki_output_dir}/ca.crt"
  }

  provisioner "local-exec" {
    interpreter = ["/bin/bash", "-c"]
    command     = <<-BASH
      set -euo pipefail

      WORK="${local.pki_work_dir}"
      OUT="${local.pki_output_dir}"

      # Clone easyrsa only if not already present
      if [ ! -d "${local.pki_root_dir}/pki-work" ]; then
        git clone --depth 1 https://github.com/OpenVPN/easy-rsa.git "${local.pki_root_dir}/pki-work"
      fi

      # Skip the entire PKI build if output certs already exist
      if [ -f "$OUT/ca.crt" ] && [ -f "$OUT/server.crt" ] && [ -f "$OUT/client.crt" ]; then
        echo "PKI output already exists — skipping rebuild."
        exit 0
      fi

      mkdir -p "$OUT"
      cd "$WORK"

      export EASYRSA_BATCH=1
      export EASYRSA_REQ_CN="ibm-vpn-ca"

      # Initialise PKI (idempotent — cleans and re-creates without prompt)
      ./easyrsa --batch init-pki

      # Build CA (no passphrase)
      ./easyrsa --batch build-ca nopass

      # Build VPN server certificate (no passphrase)
      ./easyrsa --batch build-server-full "${local.server_cn}" nopass

      # Build VPN client certificate (no passphrase)
      ./easyrsa --batch build-client-full "${local.client_cn}" nopass

      # Copy outputs to the well-known output directory
      cp pki/ca.crt                              "$OUT/ca.crt"
      cp "pki/issued/${local.server_cn}.crt"     "$OUT/server.crt"
      cp "pki/private/${local.server_cn}.key"    "$OUT/server.key"
      cp "pki/issued/${local.client_cn}.crt"     "$OUT/client.crt"
      cp "pki/private/${local.client_cn}.key"    "$OUT/client.key"

      echo "PKI generation complete."
    BASH
  }
}

####################################
# Read generated PEM files
# (depend on null_resource to ensure files exist before reading)
####################################

data "local_file" "ca_cert" {
  filename   = "${local.pki_output_dir}/ca.crt"
  depends_on = [null_resource.easyrsa_pki]
}

data "local_file" "server_cert" {
  filename   = "${local.pki_output_dir}/server.crt"
  depends_on = [null_resource.easyrsa_pki]
}

data "local_file" "server_key" {
  filename   = "${local.pki_output_dir}/server.key"
  depends_on = [null_resource.easyrsa_pki]
}

data "local_file" "client_cert" {
  filename   = "${local.pki_output_dir}/client.crt"
  depends_on = [null_resource.easyrsa_pki]
}

####################################
# Import VPN server certificate into Secrets Manager
# Requires: certificate + private_key + intermediate (CA)
####################################

resource "ibm_sm_imported_certificate" "server_cert" {
  instance_id     = local.sm_instance_id
  region          = var.region
  name            = "${var.prefix}-vpn-server-cert"
  description     = "VPN server certificate generated by easyrsa for ${local.server_cn}."
  secret_group_id = ibm_sm_secret_group.pki_group.secret_group_id
  certificate     = data.local_file.server_cert.content
  private_key     = data.local_file.server_key.content
  intermediate    = data.local_file.ca_cert.content
}

####################################
# Import VPN client CA certificate into Secrets Manager
# Requires: certificate + intermediate (CA)
# (The VPN server uses this to verify connecting clients.)
####################################

resource "ibm_sm_imported_certificate" "client_cert" {
  instance_id     = local.sm_instance_id
  region          = var.region
  name            = "${var.prefix}-vpn-client-cert"
  description     = "VPN client certificate generated by easyrsa for ${local.client_cn}."
  secret_group_id = ibm_sm_secret_group.pki_group.secret_group_id
  certificate     = data.local_file.client_cert.content
  intermediate    = data.local_file.ca_cert.content
}
